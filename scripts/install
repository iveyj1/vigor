#!/usr/bin/env bash
set -euo pipefail

trap 'rc=\$?; echo "ERROR: \${BASH_SOURCE[0]}:\${LINENO}: \${BASH_COMMAND} exited with status \${rc}" >&2; exit \${rc}' ERR
trap 'echo "Interrupted" >&2; exit 130' INT

instdir="${VIG_INSTALL_DIR:-$HOME/.config/scripts}"
mkdir -p "$instdir"
build_id="$(git log -1 --format='%h %cs' 2>/dev/null || printf development)"
echo "installing build id $build_id"
if [[ "$build_id" != development ]] && ! git diff --quiet HEAD -- vigor; then
    build_id="$build_id dirty"
fi
rm -rf "$instdir/vigor"
cp -R vigor "$instdir/"
BUILD_ID="$build_id" python3 - "$instdir/vigor/__init__.py" <<'PY'
import os, pathlib, sys
path = pathlib.Path(sys.argv[1])
text = path.read_text()
text = text.replace('BUILD_ID = "development"', f"BUILD_ID = {os.environ['BUILD_ID']!r}", 1)
path.write_text(text)
PY
cp vig vighelp "$instdir/"
rm -f "$instdir/vig-diagnostics"
cp scripts/vig-diagnostics "$instdir/vig-diag"
